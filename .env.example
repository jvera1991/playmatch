# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://qtkudukcmjypjsvsxpvl.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YETLySbO7aQAfTD01jG_Yw_AVfZOguc
# La service role key NUNCA va en el cliente. Solo en el servidor (webhooks, cron).
# Se usa para liberar cupos no pagados y confirmar reservas desde el webhook de Wompi.
# Cópiala desde: https://supabase.com/dashboard/project/qtkudukcmjypjsvsxpvl/settings/api
# (sección "service_role secret" — NUNCA la subas a GitHub ni la compartas)
SUPABASE_SERVICE_ROLE_KEY=

# ---- Wompi (Colombia) ----
# Sandbox primero: https://comercios.wompi.co -> Desarrolladores -> Llaves
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
# "Secreto de integridad" (no la llave privada) — está en la misma pantalla de Llaves.
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
NEXT_PUBLIC_WOMPI_ENV=sandbox

# ---- Google Maps ----
# Necesita "Maps JavaScript API" y "Geocoding API" habilitadas en Google Cloud
# Console, en el mismo proyecto donde generaste la llave.
#
# Llave del NAVEGADOR (visible al público, restringida por "HTTP referrer" a
# localhost:3000/* y playmatch.co/*). Se usa para dibujar el mapa en /mapa.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
#
# Llave del SERVIDOR (nunca se envía al navegador). Se usa para convertir la
# dirección de una cancha en coordenadas (lat/lng) cuando el dueño la publica
# o la edita. IMPORTANTE: debe ser una llave DISTINTA a la de arriba, SIN
# restricción de "HTTP referrer" — Google rechaza llamadas servidor-a-servidor
# con una llave restringida por referrer porque no hay navegador que envíe ese
# header. Crear en Google Cloud Console → Credenciales → Crear credenciales →
# Clave de API → Restricciones de aplicación: "Ninguna" (o "Direcciones IP"
# con la IP del VPS en producción) → Restricciones de API: solo "Geocoding API".
# Si se deja vacía, cae de vuelta a la llave de arriba (que en producción
# fallará para geocodificar por la restricción de referrer).
GOOGLE_MAPS_SERVER_API_KEY=

# ---- WhatsApp Cloud API (Meta) ----
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# ---- App ----
NEXT_PUBLIC_APP_URL=https://playmatch.co
CRON_SECRET=cambia-esto-por-un-valor-aleatorio-largo
