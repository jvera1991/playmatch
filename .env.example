# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://qtkudukcmjypjsvsxpvl.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YETLySbO7aQAfTD01jG_Yw_AVfZOguc
# La service role key NUNCA va en el cliente. Solo en el servidor (webhooks, cron).
# Se usa para liberar cupos no pagados y confirmar reservas desde el webhook de Wompi.
# Cópiala desde: https://supabase.com/dashboard/project/qtkudukcmjypjsvsxpvl/settings/api
# (sección "service_role secret" — NUNCA la subas a GitHub ni la compartas)
SUPABASE_SERVICE_ROLE_KEY=

# ---- Wompi (Colombia) ----
# Sandbox primero: https://comercios.wompi.co -> Desarrolladores -> Llaves
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
# "Secreto de integridad" (no la llave privada) — está en la misma pantalla de Llaves.
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=
NEXT_PUBLIC_WOMPI_ENV=sandbox

# ---- Mapa (Leaflet + OpenStreetMap) ----
# Desde el 06/10/2026 el mapa de /mapa NO usa Google Maps: usa Leaflet con
# teselas gratuitas de OpenStreetMap, sin llave ni facturación. Estas dos
# variables son OPCIONALES — solo cambiarlas si el tráfico crece y se pasa a un
# proveedor de teselas comercial (requiere Deploy, son NEXT_PUBLIC).
# NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
#
# Geocodificación (dirección -> coordenadas al publicar una cancha):
# por defecto usa Nominatim (OpenStreetMap), gratis y sin llave. OPCIONAL: si
# defines esta llave de Google (más precisa con direcciones tipo "Cra 43A #
# 1-50"; 10.000 consultas/mes gratis, exige cuenta de facturación), se usa
# primero. Debe estar SIN restricción de "HTTP referrer" y limitada solo a
# "Geocoding API".
GOOGLE_MAPS_SERVER_API_KEY=

# ---- WhatsApp Cloud API (Meta) ----
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# ---- App ----
NEXT_PUBLIC_APP_URL=https://playmatch.co
CRON_SECRET=cambia-esto-por-un-valor-aleatorio-largo
